# 统一按文本处理，行尾以仓库内的 LF 为准
* text=auto

# shell 脚本必须是 LF。若被 Windows 的 autocrlf 转成 CRLF，
# 容器里执行 ./start.sh 会直接以 "/bin/bash^M: bad interpreter" 启动失败。
*.sh text eol=lf

# Windows 批处理反过来必须是 CRLF
*.bat text eol=crlf

# 二进制文件不做任何行尾转换（避免被 text=auto 当文本改坏）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.flac binary
*.mp3 binary
*.m4a binary
*.zip binary
*.tar binary
*.gz binary
*.pyc binary

# 这些按文本处理，保证 diff 可读
requirements.txt text
.env.example text
Dockerfile text
