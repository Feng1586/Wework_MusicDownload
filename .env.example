# ===========================================================================
# 首次部署：cp .env.example .env，然后把下面几项填成你自己的值。
# 变量名必须和 config/config.py 里 os.environ.get(...) 读的名字完全一致，
# 否则设了也不会生效（docker-compose.yml 会把它们注入容器）。
# ===========================================================================

# --- 企业微信配置（必填）---------------------------------------------------
STOKEN=your_token_here
S_ENCODING_AES_KEY=your_encoding_aes_key_here
S_CORP_ID=your_corp_id_here
AGENT_ID=your_agent_id_here
SECRET=your_secret_here

# 企业微信 API 的接入地址。填你自己的反代地址（结尾必须带 /）；
# 若服务器能直连官方，改成 https://qyapi.weixin.qq.com/ 即可。
WECHAT_PROXY=http://zd.i-am-a.gay/

# --- 音乐平台VIP Cookies（可选）-------------------------------------------
# 留空即匿名搜索。只影响「后端不可用时的本地兜底搜索」，
# 正常路径的搜索走 backend，用的是后端自己的 Cookie。
QQ_VIP_COOKIES=
MIGU_VIP_COOKIES=
NETEASE_VIP_COOKIES=
KUWO_VIP_COOKIES=
QIANQIAN_VIP_COOKIES=

# --- 本机直接运行（python main.py）时才需要 ---------------------------------
# 这两项只对 python main.py 生效。Docker 部署不要设 PORT：
# 容器内固定监听 8000，要换对外端口请改 compose 里的端口映射（如 "9000:8000"）。
HOST=0.0.0.0
PORT=8000

# --- 下载目录（一般不用改）--------------------------------------------------
# 音乐落盘的根目录，默认 downloads（相对容器工作目录 /app，即 /app/downloads），
# 与 docker-compose.yml 里的 "./downloads:/app/downloads" 卷映射一致。
# 改了它就必须同步改卷映射，否则宿主机上依然看不到文件。
DOWNLOAD_DIR=downloads

# --- 以下一项当前刻意不支持配置，写在这里只是说明原因 -----------------------
# MUSIC_SOURCES
# 机器人只与后端约定的 QQMusicClient 交互，且下载时要按 source 去取
# music_client.music_clients[source]，换源会让后端返回的 source 找不到对应客户端。
